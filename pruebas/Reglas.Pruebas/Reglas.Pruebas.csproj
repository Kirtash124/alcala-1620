<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas de las reglas del juego. No dependen de Godot: se ejecutan con «dotnet test». -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Alcala.Reglas.Pruebas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../codigo/Reglas/**/*.cs" Link="Reglas/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../codigo/Juego/CicloMarcha.cs" Link="Animacion/CicloMarcha.cs" />
    <Compile Include="../../codigo/Juego/GestoMarcha.cs" Link="Animacion/GestoMarcha.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
